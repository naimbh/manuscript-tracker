APP_NAME="Manuscript Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI venue updates (Claude with web search)
# AI provider: claude-code, api (Anthropic), openai, gemini or compatible. You can also set all of this in Settings → AI.
AI_DRIVER=claude-code
# Leave empty to auto-detect the CLI (PATH or the copy inside the Claude desktop app).
CLAUDE_CODE_BIN=
# Run `claude setup-token` once and paste the token here so the app can use the CLI.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=opus
# Only for AI_DRIVER=api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# PHP binary used to run background scans
PHP_CLI_BIN=
# Only for AI_DRIVER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Only for AI_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only for AI_DRIVER=compatible (OpenRouter, Groq, Perplexity, Ollama…)
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=

# First account created by `php artisan migrate --seed`
TRACKER_ADMIN_NAME=Admin
TRACKER_ADMIN_EMAIL=admin@gmail.com
TRACKER_ADMIN_PASSWORD=123456

# Schedules (server time; days: 0 = Sunday … 6 = Saturday)
TRACKER_SCAN_TIME=06:00
TRACKER_VENUES_DAY=1
TRACKER_VENUES_TIME=07:00
TRACKER_CITATIONS_DAY=3
TRACKER_CITATIONS_TIME=07:00

# Footer credit (leave empty to hide)
TRACKER_CREDIT_NAME="Naim Bin Hasan"
TRACKER_CREDIT_URL=https://naimbh.com/dev

# Account the local MCP server acts for (defaults to the first account)
TRACKER_MCP_USER=

# Site identity and sign-ups (the admin can change these in Settings → General)
TRACKER_TAGLINE="from draft to decision"
TRACKER_DESCRIPTION=
TRACKER_CONTACT_EMAIL=
TRACKER_REGISTRATION=true
